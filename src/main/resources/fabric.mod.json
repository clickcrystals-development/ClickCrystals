{
  "schemaVersion": 1,
  "id": "clickcrystals",
  "version": "${version}",
  "name": "ClickCrystals Modified",
  "description": "Gergherobrine's configurable, player-directed PvP toolkit with extended ClickScript sensors.",
  "authors": [
    "Gergherobrine"
  ],
  "contact": {
    "homepage": "https://github.com/Gergherobrine/ClickCrystals-Modified",
    "sources": "https://github.com/Gergherobrine/ClickCrystals-Modified",
    "issues": "https://github.com/Gergherobrine/ClickCrystals-Modified/issues"
  },
  "license": "MIT",
  "icon": "assets/clickcrystals/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.itzispyder.clickcrystals.client.ClickCrystalsClient"
    ],
    "main": [
      "io.github.itzispyder.clickcrystals.ClickCrystals"
    ],
    "modmenu": [
      "io.github.itzispyder.clickcrystals.client.system.ModMenuIntegration"
    ]
